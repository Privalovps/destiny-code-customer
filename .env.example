# Copy locally to .env.local; never commit real credentials.
# Must exactly match the browser origin. HTTPS required for production.
APP_ORIGIN=http://127.0.0.1:3000
# Enables only the volatile loopback development simulator. Ignored in production.
DESTINY_CODE_DEV_CHECKOUT=0
# Keep disabled until real payment AND transactional email adapters are implemented/tested.
ENABLE_LIVE_CHECKOUT=0
# Server-only Supabase project URL and legacy service_role JWT (never NEXT_PUBLIC_*).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# >=32 random characters, protects explicit delivery-worker calls. No worker runs automatically.
DELIVERY_SECRET=
# Provider-specific credentials will be documented when actual providers are selected.

# Local historical UI rollback only. Deployed free/sample routes always use the current 38-value edition.
DESTINY_CODE_READING_RELEASE=research-c

# Independent owner preview: no orders, cookies or entitlements. Server-only; loopback development only.
DESTINY_CODE_LOCAL_REPORT_PREVIEW=0

# Public HTTPS website origin for metadata after domain setup. Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_SITE_URL=
# On deployments set APP_ORIGIN to the exact HTTPS customer origin (not the local example above).
# Keep ENABLE_LIVE_CHECKOUT=0 and all DESTINY_CODE_* development flags at 0/unset.
